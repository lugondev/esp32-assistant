CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y

# Force-select the C3 board so the build is deterministic (both C3 boards share
# the same SSD1306 I2C probe, so autodetect can't tell them apart). DevKitM-1
# (MINI-1 module) is the working board — its antenna is fine, unlike the
# SuperMini. Swap to CONFIG_AA_BOARD_LUGO_C3_SUPERMINI=y for that board.
# NOTE: 160MHz is the C3's hardware maximum — there is NO 240MHz option (unlike
# S3). If opus_encode overruns the 60ms budget (watch "opus encode new max"),
# the fix is lower opus complexity / less CPU contention, not a higher clock.
CONFIG_AA_BOARD_LUGO_C3_DEVKIT=y

# ---- C3 low-RAM WiFi/lwip tuning (PERMANENT, safe to commit) ----
# The C3 has no PSRAM; after WiFi+WS+display+opus only ~23KB internal RAM is free
# with a ~9KB largest contiguous block — too small for the opus-encode mic task's
# stack. The default WiFi buffer pool (10 static RX, 32 dyn RX/TX, AMPDU reorder
# windows) both consumes RAM and fragments the heap. This device only holds one
# low-bitrate (~24kbps opus) WebSocket, so a small buffer pool is plenty and
# frees a large contiguous block for the audio task stacks. Throughput drops but
# audio is unaffected.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=12
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=12
# Disable AMPDU: frees the RX block-ack reorder buffers (RX_BA_WIN); negligible
# impact at audio bitrates.
# CONFIG_ESP_WIFI_AMPDU_TX_ENABLED is not set
# CONFIG_ESP_WIFI_AMPDU_RX_ENABLED is not set
CONFIG_LWIP_MAX_SOCKETS=6
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=2880
CONFIG_LWIP_TCP_WND_DEFAULT=2880

# Console on native USB-Serial-JTAG (the C3 default, and the config that ran the
# app on the flash port without a port swap). Reverted from a UART-console
# experiment that correlated with the flash port latching download mode.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
