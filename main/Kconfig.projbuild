menu "Assistant configuration"

config AA_SERVER_HOST
    string "Gateway host (IP or domain)"
    default "192.168.1.50"

config AA_SERVER_PORT
    int "Gateway port"
    default 8000

config AA_SERVER_SECURE
    bool "Use wss:// (TLS)"
    default n

config AA_WIFI_SSID
    string "SIMULATOR ONLY: hardcoded WiFi SSID (leave empty on hardware)"
    default ""
    help
        Leave this empty. Real devices get their credentials from the setup
        portal (SoftAP "Lugo-XXXX" -> pick a network -> save), which writes
        them to NVS; an empty SSID here just means app_main goes straight to
        that portal on first boot instead of burning 15s on a connect attempt
        that cannot succeed.

        The one legitimate use is sdkconfig.wokwi, which sets "Wokwi-GUEST"
        (the simulator's fixed virtual AP) because the phone-joins-the-AP
        provisioning flow cannot be simulated. Setting it for a hardware build
        bakes a credential into the firmware image and shadows whatever the
        portal saved on first boot only -- see wifi_cfg_load, where NVS still
        wins once anything is stored.

config AA_WIFI_PASS
    string "SIMULATOR ONLY: hardcoded WiFi password (paired with AA_WIFI_SSID)"
    default ""

config AA_BOOT_COLOR_BARS
    bool "Show RGB color bars for 2s at boot (display smoke test)"
    default n
    help
        One-time color-pipeline smoke test: paints 5 real color bars right
        after display_init() and holds them for 2 seconds, so a wrong RGB565
        channel/bit order is visible at a glance (the green-on-black eyes
        alone would hide it). Costs ~2s on every boot, so it's off by
        default — enable when bringing up a new panel or rewiring SPI.

config AA_AUTO_WAKE
    bool "Auto-wake at boot (connect to gateway without a Wake button)"
    default n
    help
        Dev/bring-up aid: enter the active/listening state at boot so the device
        opens the gateway WebSocket immediately, instead of waiting for a physical
        Wake button press. Leave off for normal builds (connect-on-wake).

config AA_MIC_METER
    bool "Show mic peak level on the display (mic bring-up)"
    default n
    help
        Dev/bring-up: skip the gateway and render the mic's last read count +
        peak amplitude on the panel (~5x/sec) so a silent vs working mic is
        visible without the serial console. Takes precedence over AA_AUTO_WAKE.
        Leave off for normal builds.

config AA_AUDIO_LOOPBACK
    bool "Mic->speaker loopback self-test (audio bring-up)"
    default n
    help
        Dev/bring-up: replaces the whole app with a mic/speaker loopback test.
        Press BOOT to start recording, press BOOT again to stop and hear the
        take played back; it also stops on its own at the buffer cap (10s in
        PSRAM, less on a board without it).

        app_main runs board/display/audio init and then never returns from the
        test, so WiFi, the gateway WebSocket, opus and every audio task are out
        of the picture -- a silent mic or a dead amp cannot be blamed on the
        network or on CPU contention. Each recorded frame logs its peak
        amplitude, so a mic that captures nothing (peak stays 0) is
        distinguishable from a speaker that plays nothing at a glance.

        Takes precedence over AA_MIC_METER and AA_AUTO_WAKE. Leave off for
        normal builds.

config AA_AUDIO_LOOPBACK_BTN_GPIO
    int "GPIO of the BOOT button used by the loopback self-test"
    depends on AA_AUDIO_LOOPBACK
    default 9 if IDF_TARGET_ESP32C3
    default 0
    help
        The module's onboard BOOT button, NOT the board's wired Wake button --
        the test deliberately bypasses the buttons component so it still works
        when the wired button's pin is itself under suspicion. GPIO0 on the S3
        SuperMini, GPIO9 on the C3 SuperMini. Change only if your module wires
        BOOT elsewhere.

config AA_SKIP_DISPLAY_INIT
    bool "Skip display panel hardware init (bring-up isolation)"
    default n
    help
        Leaves the display driver registered but skips the actual panel bring-up
        (no I2C/SPI traffic); show()/flush() become no-ops. Use to isolate a
        WiFi/audio bring-up from a flaky/absent panel. Leave off for normal builds.

config AA_SKIP_AUDIO_INIT
    bool "Skip mic/speaker I2S hardware init (Wokwi simulation only)"
    default n
    help
        Wokwi's simulated ESP32-S3 I2S peripheral never sets the clock-ready
        flag that i2s_channel_enable() polls for, so mic_init()/speaker_init()
        hang forever on boot in the simulator (confirmed via task-watchdog
        backtrace: stuck in i2s_ll_rx_start, called from mic_init audio_init
        app_main). Real hardware is unaffected and does not need this.
        Enabling this makes audio_init() skip the actual I2S bring-up; the
        audio_mic_read/audio_spk_write/etc. wrappers become no-ops so the
        rest of app_main() (WiFi, display, buttons, gateway) still runs.
        Leave off for any real-hardware build.

choice AA_BOARD
    prompt "Target board"
    default AA_BOARD_LUGO_S3_NX if IDF_TARGET_ESP32S3
    default AA_BOARD_LUGO_C3_DEVKIT if IDF_TARGET_ESP32C3

config AA_BOARD_LUGO_S3_NX
    bool "Lugo S3 NX — N-series modules N16R8/N8R8 (auto SSD1306/ST7789 + MAX98357A/INMP441 dual-I2S)"
    depends on IDF_TARGET_ESP32S3

config AA_BOARD_LUGO_S3_SUPERMINI
    bool "Lugo S3 SuperMini — ESP32-S3FH4R2, 4MB flash + 2MB quad PSRAM (SSD1306 I2C + MAX98357A/INMP441 dual-I2S)"
    depends on IDF_TARGET_ESP32S3

config AA_BOARD_LUGO_S3_WROOM
    bool "Lugo S3 WROOM (auto display, camera-capable) [placeholder pins]"
    depends on IDF_TARGET_ESP32S3

config AA_BOARD_LUGO_C3_DEVKIT
    bool "Lugo C3 DevKitM-1 (SSD1306 0.96in I2C + MAX98357A/INMP441 full-duplex I2S)"
    depends on IDF_TARGET_ESP32C3

config AA_BOARD_LUGO_C3_SUPERMINI
    bool "Lugo C3 SuperMini (SSD1306 0.96in I2C + MAX98357A/INMP441 full-duplex I2S)"
    depends on IDF_TARGET_ESP32C3

# Deliberately no `depends on IDF_TARGET_*`, unlike every other entry above.
# That asymmetry is intentional: on a target we do not support yet, adding one
# would hide every entry in this choice, AA_BOARD_NAME would fall through to
# "", and components/boards/CMakeLists.txt would glob-build every board,
# register none, and fail at boot with registered=0. Visible-everywhere instead
# means such a target selects lugo-custom and hits its #error at compile time,
# which is the right diagnostic at the right moment. Do not "fix" this.
config AA_BOARD_CUSTOM
    bool "Custom board — enter the pinout below (bring-up / new hardware)"
    help
        For hardware that has no board_def.c yet. Every pin comes from the
        "Custom board pinout" menu below, so trying a new board needs no new
        files. Once the pinout is proven, promote it to its own
        components/boards/<name>/board_def.c — that file is where the reasons
        behind each choice get written down, which this menu cannot hold.
endchoice

config AA_BOARD_NAME
    string
    default "lugo-s3-nx" if AA_BOARD_LUGO_S3_NX
    default "lugo-s3-supermini" if AA_BOARD_LUGO_S3_SUPERMINI
    default "lugo-s3-wroom" if AA_BOARD_LUGO_S3_WROOM
    default "lugo-c3-devkit" if AA_BOARD_LUGO_C3_DEVKIT
    default "lugo-c3-supermini" if AA_BOARD_LUGO_C3_SUPERMINI
    default "lugo-custom" if AA_BOARD_CUSTOM
    default ""

endmenu

menu "Custom board pinout"
    visible if AA_BOARD_CUSTOM

# `visible if` rather than `depends on`: it hides the prompts for anyone
# building a known board while leaving each symbol at its default value. With
# `depends on`, an unmet dependency drives int symbols to 0 — and 0 is a real
# GPIO, so a stray value would look like a deliberate pin rather than an unset
# one.

config AA_CUSTOM_MIC_WS
    int "INMP441 mic I2S WS/LRCK gpio"
    depends on IDF_TARGET_ESP32S3
    range 0 48
    default 4
config AA_CUSTOM_MIC_SCK
    int "INMP441 mic I2S SCK/BCLK gpio"
    depends on IDF_TARGET_ESP32S3
    range 0 48
    default 5
config AA_CUSTOM_MIC_SD
    int "INMP441 mic I2S SD (data out from mic) gpio"
    depends on IDF_TARGET_ESP32S3
    range 0 48
    default 6
config AA_CUSTOM_MIC_RIGHT_SLOT
    bool "INMP441 L/R is tied HIGH (mic drives the RIGHT I2S slot)"
    depends on IDF_TARGET_ESP32S3
    default n
    help
        Leave off when L/R goes to GND, which is the usual wiring. Turn it on
        for a module with L/R tied to 3V3. Reading the wrong slot yields a
        channel of pure zeros that looks exactly like a dead mic, so if the mic
        is silent and the pins are confirmed, try the other setting.

config AA_CUSTOM_SPK_BCLK
    int "MAX98357A speaker I2S BCLK gpio"
    depends on IDF_TARGET_ESP32S3
    range 0 48
    default 15
config AA_CUSTOM_SPK_LRC
    int "MAX98357A speaker I2S LRC/WS gpio"
    depends on IDF_TARGET_ESP32S3
    range 0 48
    default 16
config AA_CUSTOM_SPK_DIN
    int "MAX98357A speaker I2S DIN (data into amp) gpio"
    depends on IDF_TARGET_ESP32S3
    range 0 48
    default 7

config AA_CUSTOM_FD_BCLK
    int "Shared full-duplex I2S BCLK gpio (speaker's bit clock)"
    depends on IDF_TARGET_ESP32C3
    range 0 21
    default 7
config AA_CUSTOM_FD_WS
    int "Shared full-duplex I2S WS gpio (speaker's word select)"
    depends on IDF_TARGET_ESP32C3
    range 0 21
    default 3
config AA_CUSTOM_FD_MIC_DATA
    int "INMP441 SD (data in) gpio"
    depends on IDF_TARGET_ESP32C3
    range 0 21
    default 10
config AA_CUSTOM_FD_SPK_DATA
    int "MAX98357A DIN (data out) gpio"
    depends on IDF_TARGET_ESP32C3
    range 0 21
    default 6
config AA_CUSTOM_FD_MIC_BCLK
    int "Mic's own SCK gpio, or -1 if it shares the speaker's BCLK"
    depends on IDF_TARGET_ESP32C3
    range -1 21
    default -1
    help
        The C3 has one I2S controller. When the mic is physically wired to its
        own SCK/WS pins rather than tied to the speaker's, set these two and the
        controller's clock is duplicated onto them through the GPIO matrix. Set
        both to -1 when the mic shares the speaker's clock pins.
config AA_CUSTOM_FD_MIC_WS
    int "Mic's own WS gpio, or -1 if it shares the speaker's WS"
    depends on IDF_TARGET_ESP32C3
    range -1 21
    default -1

choice AA_CUSTOM_DISP
    prompt "Display this board can carry"
    default AA_CUSTOM_DISP_SSD1306

config AA_CUSTOM_DISP_AUTO
    bool "Either — probe I2C for an SSD1306, else drive an ST7789 on the same pins"
config AA_CUSTOM_DISP_SSD1306
    bool "SSD1306 only (I2C OLED)"
config AA_CUSTOM_DISP_NONE
    bool "No display"
endchoice

# Display and button pins are the same symbols on both targets (unlike the
# audio pins above, which are split by `depends on IDF_TARGET_*`), so their
# ranges and defaults have to be split per target instead. The C3 tops out at
# GPIO21, and its GPIO12-17 are the in-package SPI flash bus (GPIO11 is
# VDD_SPI) — an S3 default inherited unchanged would have the display probe
# reconfigure a live flash pin at boot. The C3 defaults below are the wiring
# both real C3 boards use (lugo_c3_devkit, lugo_c3_supermini); DC/RST land on
# GPIO20/21, which is only free because those boards put the console on the
# native USB-Serial-JTAG rather than UART0.
config AA_CUSTOM_DISP_CLK
    int "Display SCL (SSD1306) / SCLK (ST7789) gpio"
    depends on !AA_CUSTOM_DISP_NONE
    range 0 48 if IDF_TARGET_ESP32S3
    range 0 21 if IDF_TARGET_ESP32C3
    default 2 if IDF_TARGET_ESP32S3
    default 5 if IDF_TARGET_ESP32C3
config AA_CUSTOM_DISP_DAT
    int "Display SDA (SSD1306) / MOSI (ST7789) gpio"
    depends on !AA_CUSTOM_DISP_NONE
    range 0 48 if IDF_TARGET_ESP32S3
    range 0 21 if IDF_TARGET_ESP32C3
    default 13 if IDF_TARGET_ESP32S3
    default 4 if IDF_TARGET_ESP32C3
config AA_CUSTOM_DISP_DC
    int "ST7789 DC gpio"
    depends on AA_CUSTOM_DISP_AUTO
    range 0 48 if IDF_TARGET_ESP32S3
    range 0 21 if IDF_TARGET_ESP32C3
    default 1 if IDF_TARGET_ESP32S3
    default 20 if IDF_TARGET_ESP32C3
config AA_CUSTOM_DISP_RST
    int "ST7789 RST gpio"
    depends on AA_CUSTOM_DISP_AUTO
    range 0 48 if IDF_TARGET_ESP32S3
    range 0 21 if IDF_TARGET_ESP32C3
    default 11 if IDF_TARGET_ESP32S3
    default 21 if IDF_TARGET_ESP32C3
config AA_CUSTOM_DISP_BL
    int "ST7789 backlight gpio, or -1 if the panel LED is tied to 3V3"
    depends on AA_CUSTOM_DISP_AUTO
    range -1 48 if IDF_TARGET_ESP32S3
    range -1 21 if IDF_TARGET_ESP32C3
    default -1

config AA_CUSTOM_BTN_WAKE
    int "Wake button gpio (active low), or -1 if absent"
    range -1 48 if IDF_TARGET_ESP32S3
    range -1 21 if IDF_TARGET_ESP32C3
    default -1
config AA_CUSTOM_BTN_VOL_UP
    int "Volume-up button gpio (active low), or -1 if absent"
    range -1 48 if IDF_TARGET_ESP32S3
    range -1 21 if IDF_TARGET_ESP32C3
    default -1
config AA_CUSTOM_BTN_VOL_DOWN
    int "Volume-down button gpio (active low), or -1 if absent"
    range -1 48 if IDF_TARGET_ESP32S3
    range -1 21 if IDF_TARGET_ESP32C3
    default -1
config AA_CUSTOM_BTN_EMOTION
    int "Emotion button gpio (active low), or -1 if absent"
    range -1 48 if IDF_TARGET_ESP32S3
    range -1 21 if IDF_TARGET_ESP32C3
    default -1

endmenu
