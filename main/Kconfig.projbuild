menu "Assistant configuration"

config AA_SERVER_HOST
    string "Gateway host (IP or domain)"
    default "192.168.1.50"

config AA_SERVER_PORT
    int "Gateway port"
    default 8000

config AA_SERVER_SECURE
    bool "Use wss:// (TLS)"
    default n

config AA_WIFI_SSID
    string "Fallback WiFi SSID (used only until provisioning saves one to NVS)"
    default ""
    help
        Real devices always provision over the captive portal, so this stays
        empty for hardware builds. Set to "Wokwi-GUEST" (Wokwi's fixed virtual
        AP name) only in a Wokwi-specific sdkconfig, so STA connect succeeds
        in simulation without going through the (un-simulatable) AP-join flow.

config AA_WIFI_PASS
    string "Fallback WiFi password (paired with AA_WIFI_SSID)"
    default ""

config AA_PROFILE
    string "Chatllm profile name"
    default ""
    help
        Named profile created on the gateway via POST /v1/profiles (or the control
        panel), bundling the STT engine + language, TTS voice, LLM model/system
        prompt, MCP tools and memory. Sent in the Lugo `wakeup` handshake on
        connect (WS /v1/lugo/stream) — the device configures only which profile to
        use, not the engines. Leave empty to fall back to the server's own .env
        defaults (30s idle timeout, default engines).

config AA_DEVICE_TOKEN
    string "Device WS auth token (stopgap shared secret)"
    default ""
    help
        Sent as ?device_token=<value> on the /v1/lugo/stream WS URI. Must match
        the gateway's DEVICE_AUTH_TOKEN env var when the gateway has auth
        enabled (ADMIN_PASSWORD or ADMIN_BOOTSTRAP_PASSWORD set) — otherwise
        the WS upgrade is rejected with HTTP 403 before ever reaching the app.
        This is a temporary shared-secret stopgap (same token on every device).
        TODO: replace with the real per-device pairing flow (POST
        /v1/devices/pair/init + claim) once firmware supports it, then leave
        this empty.

config AA_MIC_WS
    int "INMP441 mic I2S WS/LRCK gpio"
    default 4
config AA_MIC_SCK
    int "INMP441 mic I2S SCK/BCLK gpio"
    default 5
config AA_MIC_SD
    int "INMP441 mic I2S SD (data out from mic) gpio"
    default 6

config AA_SPK_BCLK
    int "MAX98357A speaker I2S BCLK gpio"
    default 15
config AA_SPK_LRC
    int "MAX98357A speaker I2S LRC/WS gpio"
    default 16
config AA_SPK_DIN
    int "MAX98357A speaker I2S DIN (data into amp) gpio"
    default 7

config AA_SKIP_AUDIO_INIT
    bool "Skip mic/speaker I2S hardware init (Wokwi simulation only)"
    default n
    help
        Wokwi's simulated ESP32-S3 I2S peripheral never sets the clock-ready
        flag that i2s_channel_enable() polls for, so mic_init()/speaker_init()
        hang forever on boot in the simulator (confirmed via task-watchdog
        backtrace: stuck in i2s_ll_rx_start, called from mic_init audio_init
        app_main). Real hardware is unaffected and does not need this.
        Enabling this makes audio_init() skip the actual I2S bring-up; the
        audio_mic_read/audio_spk_write/etc. wrappers become no-ops so the
        rest of app_main() (WiFi, display, buttons, gateway) still runs.
        Leave off for any real-hardware build.

choice AA_BOARD
    prompt "Target board"
    default AA_BOARD_AUTODETECT

config AA_BOARD_LUGO_S3_ST7789
    bool "Lugo S3 (ST7789 + MAX98357A/INMP441 dual-I2S)"
    depends on IDF_TARGET_ESP32S3

config AA_BOARD_LUGO_S3_SSD1306
    bool "Lugo S3 (SSD1306 0.96in SPI + MAX98357A/INMP441 dual-I2S)"
    depends on IDF_TARGET_ESP32S3

config AA_BOARD_LUGO_C3_DEVKIT
    bool "Lugo C3 devkit (full-duplex I2S) [pins are placeholders]"
    depends on IDF_TARGET_ESP32C3

config AA_BOARD_AUTODETECT
    bool "Auto-detect (multi-board single binary)"
endchoice

config AA_BOARD_FORCE
    bool
    default y if !AA_BOARD_AUTODETECT

config AA_BOARD_NAME
    string
    default "lugo-s3-st7789" if AA_BOARD_LUGO_S3_ST7789
    default "lugo-s3-ssd1306" if AA_BOARD_LUGO_S3_SSD1306
    default "lugo-c3-devkit" if AA_BOARD_LUGO_C3_DEVKIT
    default ""

endmenu
