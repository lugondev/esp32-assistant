menu "Assistant configuration"

config AA_SERVER_HOST
    string "Gateway host (IP or domain)"
    default "192.168.1.50"

config AA_SERVER_PORT
    int "Gateway port"
    default 8000

config AA_SERVER_SECURE
    bool "Use wss:// (TLS)"
    default n

config AA_STT_ENGINE
    string "STT engine"
    default "whisper_mlx"

config AA_TTS_ENGINE
    string "TTS engine"
    default "vieneu"

config AA_LANGUAGE
    string "Language hint"
    default "vi"

config AA_PROFILE
    string "Chatllm profile name (optional)"
    default ""
    help
        Named profile created on the gateway via POST /v1/profiles, bundling LLM
        model/system prompt/TTS/MCP tools/memory. When set, sent as &profile=<name>
        on the WS URL and overrides the server's .env LLM defaults for this device.
        Leave empty to omit (device uses AA_STT_ENGINE/AA_TTS_ENGINE/AA_LANGUAGE only).

config AA_MIC_WS
    int "INMP441 mic I2S WS/LRCK gpio"
    default 4
config AA_MIC_SCK
    int "INMP441 mic I2S SCK/BCLK gpio"
    default 5
config AA_MIC_SD
    int "INMP441 mic I2S SD (data out from mic) gpio"
    default 6

config AA_SPK_BCLK
    int "MAX98357A speaker I2S BCLK gpio"
    default 15
config AA_SPK_LRC
    int "MAX98357A speaker I2S LRC/WS gpio"
    default 16
config AA_SPK_DIN
    int "MAX98357A speaker I2S DIN (data into amp) gpio"
    default 7

endmenu
