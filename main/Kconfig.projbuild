menu "Assistant configuration"

config AA_SERVER_HOST
    string "Gateway host (IP or domain)"
    default "192.168.1.50"

config AA_SERVER_PORT
    int "Gateway port"
    default 8000

config AA_SERVER_SECURE
    bool "Use wss:// (TLS)"
    default n

config AA_WIFI_SSID
    string "Fallback WiFi SSID (used only until provisioning saves one to NVS)"
    default ""
    help
        Real devices always provision over the captive portal, so this stays
        empty for hardware builds. Set to "Wokwi-GUEST" (Wokwi's fixed virtual
        AP name) only in a Wokwi-specific sdkconfig, so STA connect succeeds
        in simulation without going through the (un-simulatable) AP-join flow.

config AA_WIFI_PASS
    string "Fallback WiFi password (paired with AA_WIFI_SSID)"
    default ""

config AA_PROFILE
    string "Chatllm profile name"
    default ""
    help
        Named profile created on the gateway via POST /v1/profiles (or the control
        panel), bundling the STT engine + language, TTS voice, LLM model/system
        prompt, MCP tools and memory. Sent in the Lugo `wakeup` handshake on
        connect (WS /v1/lugo/stream) — the device configures only which profile to
        use, not the engines. Leave empty to fall back to the server's own .env
        defaults (30s idle timeout, default engines).

config AA_DEVICE_TOKEN
    string "Device WS auth token (optional override)"
    default ""
    help
        Optional override; empty for normal pairing. If set, used verbatim as
        ?device_token=<value> on the /v1/lugo/stream WS URI and normal
        per-device pairing (POST /v1/devices/pair/init + claim, see
        components/pairing) is skipped entirely. This is a static dev/legacy
        value: it is never wiped or re-paired automatically even if the
        gateway rejects/revokes it (see resolve_device_token() in main.c) --
        clearing an override requires a manual reflash/reconfigure. Leave
        empty (the default) so the device pairs itself on first boot and
        stores its own per-device token in NVS.

config AA_MIC_WS
    int "INMP441 mic I2S WS/LRCK gpio"
    default 4
config AA_MIC_SCK
    int "INMP441 mic I2S SCK/BCLK gpio"
    default 5
config AA_MIC_SD
    int "INMP441 mic I2S SD (data out from mic) gpio"
    default 6

config AA_SPK_BCLK
    int "MAX98357A speaker I2S BCLK gpio"
    default 15
config AA_SPK_LRC
    int "MAX98357A speaker I2S LRC/WS gpio"
    default 16
config AA_SPK_DIN
    int "MAX98357A speaker I2S DIN (data into amp) gpio"
    default 7

config AA_BOOT_COLOR_BARS
    bool "Show RGB color bars for 2s at boot (display smoke test)"
    default n
    help
        One-time color-pipeline smoke test: paints 5 real color bars right
        after display_init() and holds them for 2 seconds, so a wrong RGB565
        channel/bit order is visible at a glance (the green-on-black eyes
        alone would hide it). Costs ~2s on every boot, so it's off by
        default — enable when bringing up a new panel or rewiring SPI.

config AA_AUTO_WAKE
    bool "Auto-wake at boot (connect to gateway without a Wake button)"
    default n
    help
        Dev/bring-up aid: enter the active/listening state at boot so the device
        opens the gateway WebSocket immediately, instead of waiting for a physical
        Wake button press. Leave off for normal builds (connect-on-wake).

config AA_MIC_METER
    bool "Show mic peak level on the display (mic bring-up)"
    default n
    help
        Dev/bring-up: skip the gateway and render the mic's last read count +
        peak amplitude on the panel (~5x/sec) so a silent vs working mic is
        visible without the serial console. Takes precedence over AA_AUTO_WAKE.
        Leave off for normal builds.

config AA_SKIP_DISPLAY_INIT
    bool "Skip display panel hardware init (bring-up isolation)"
    default n
    help
        Leaves the display driver registered but skips the actual panel bring-up
        (no I2C/SPI traffic); show()/flush() become no-ops. Use to isolate a
        WiFi/audio bring-up from a flaky/absent panel. Leave off for normal builds.

config AA_SKIP_AUDIO_INIT
    bool "Skip mic/speaker I2S hardware init (Wokwi simulation only)"
    default n
    help
        Wokwi's simulated ESP32-S3 I2S peripheral never sets the clock-ready
        flag that i2s_channel_enable() polls for, so mic_init()/speaker_init()
        hang forever on boot in the simulator (confirmed via task-watchdog
        backtrace: stuck in i2s_ll_rx_start, called from mic_init audio_init
        app_main). Real hardware is unaffected and does not need this.
        Enabling this makes audio_init() skip the actual I2S bring-up; the
        audio_mic_read/audio_spk_write/etc. wrappers become no-ops so the
        rest of app_main() (WiFi, display, buttons, gateway) still runs.
        Leave off for any real-hardware build.

choice AA_BOARD
    prompt "Target board"
    default AA_BOARD_AUTODETECT

config AA_BOARD_LUGO_S3_DEVKIT
    bool "Lugo S3 devkit (auto SSD1306/ST7789 + MAX98357A/INMP441 dual-I2S)"
    depends on IDF_TARGET_ESP32S3

config AA_BOARD_LUGO_S3_SUPERMINI
    bool "Lugo S3 SuperMini (auto display) [placeholder pins]"
    depends on IDF_TARGET_ESP32S3

config AA_BOARD_LUGO_S3_WROOM
    bool "Lugo S3 WROOM (auto display, camera-capable) [placeholder pins]"
    depends on IDF_TARGET_ESP32S3

config AA_BOARD_LUGO_C3_DEVKIT
    bool "Lugo C3 DevKitM-1 (SSD1306 0.96in I2C + MAX98357A/INMP441 full-duplex I2S)"
    depends on IDF_TARGET_ESP32C3

config AA_BOARD_LUGO_C3_SUPERMINI
    bool "Lugo C3 SuperMini (SSD1306 0.96in I2C + MAX98357A/INMP441 full-duplex I2S)"
    depends on IDF_TARGET_ESP32C3

config AA_BOARD_AUTODETECT
    bool "Auto-detect (multi-board single binary)"
endchoice

config AA_BOARD_FORCE
    bool
    default y if !AA_BOARD_AUTODETECT

config AA_BOARD_NAME
    string
    default "lugo-s3-devkit" if AA_BOARD_LUGO_S3_DEVKIT
    default "lugo-s3-supermini" if AA_BOARD_LUGO_S3_SUPERMINI
    default "lugo-s3-wroom" if AA_BOARD_LUGO_S3_WROOM
    default "lugo-c3-devkit" if AA_BOARD_LUGO_C3_DEVKIT
    default "lugo-c3-supermini" if AA_BOARD_LUGO_C3_SUPERMINI
    default ""

endmenu
