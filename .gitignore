# ESP-IDF build output
build/
# ESP32-C3 build output (separate target dir; see sdkconfig.defaults.esp32c3)
build-c3/
sdkconfig.c3
# ESP32-S3 SuperMini build output (separate dir so the NX build is untouched;
# sdkconfig.defaults.s3supermini is the tracked source overlay, sdkconfig.s3sm
# is the generated merge — see docs/s3-supermini.md)
build-s3sm/
sdkconfig.s3sm
sdkconfig.s3sm.old
sdkconfig
sdkconfig.old
managed_components/
dependencies.lock

# Wokwi-only build output (see wokwi.toml; sdkconfig.wokwi is the tracked
# source override, sdkconfig.wokwi.generated is the merged output)
build-wokwi/
sdkconfig.wokwi.generated
sdkconfig.wokwi.generated.old

# Editor / tooling caches
.cache/

# Wokwi custom-chip build output (recompile with `wokwi-cli chip compile`;
# sources like *.chip.c/*.chip.json are tracked)
*.chip.wasm
wokwi-api.h
test/test_battery_logic
test/test_statusbar
test/test_pairing_logic
test/test_i2s_pcm
test/test_button_hold

# Subagent-driven-development scratch workspace (ledger, briefs, review
